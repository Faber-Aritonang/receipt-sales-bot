# URL server Python (FastAPI)
PYTHON_API_URL=http://127.0.0.1:8000

# Harus SAMA dengan BRIDGE_WEBHOOK_SECRET di .env project Python
BRIDGE_WEBHOOK_SECRET=ganti-ini-dengan-string-acak

# Port endpoint /send (opsional)
BRIDGE_PORT=3100

# (Opsional) Password untuk melihat halaman QR di browser (http://IP:3100/qr).
# Kosongkan = tanpa proteksi. Bisa sama dengan DASHBOARD_PASSWORD di .env root.
QR_PASSWORD=

# (Opsional) Whitelist nomor yang boleh memakai bot (Telegram & WhatsApp).
# Format: nomor internasional tanpa '+', dipisah koma. Contoh: 6280000000000,6281111111111
# Kosongkan = SEMUA nomor boleh. Pesan dari perangkat sendiri selalu diproses.
# Di Telegram, pengguna baru diminta membagikan nomornya sekali untuk verifikasi.
# WHATSAPP_ALLOWED_NUMBERS=6280000000000

# (Opsional) Direktori data runtime (session auth/, whitelist, id pesan, QR).
# Default = folder whatsapp-bridge. Dipakai saat deploy di platform dengan
# persistent disk (mis. Render: set ke mount path disk, contoh /app/data).
# BRIDGE_DATA_DIR=/app/data
