# ============ TELEGRAM ============
# Token dari @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# (Opsional) ID Telegram yang boleh memakai bot TANPA verifikasi nomor
# (dipisah koma, contoh: 123456789,987654321).
# User lain tetap bisa masuk bila nomornya ada di whitelist (lihat
# WHATSAPP_ALLOWED_NUMBERS / perintah /izinkan) — mereka diminta membagikan
# nomor sekali lewat tombol "Bagikan Nomor". Kosongkan kedua-duanya = semua orang boleh.
TELEGRAM_ALLOWED_IDS=

# (Opsional) Chat id Telegram untuk notifikasi restart otomatis oleh watchdog
# (kosong = fallback ke TELEGRAM_ALLOWED_IDS pertama; keduanya kosong = tanpa notifikasi)
# WATCHDOG_NOTIFY_CHAT_ID=

# ============ WHATSAPP BRIDGE (Node.js/Baileys) ============
# URL + port server bridge (whatsapp-bridge/index.js)
BRIDGE_URL=http://127.0.0.1:3100
BRIDGE_PORT=3100

# ============ API / DASHBOARD ============
API_HOST=0.0.0.0
API_PORT=8000

# (Opsional) Username & password untuk membuka dashboard web. Kosongkan
# password = tanpa login. Jika diisi, semua halaman & API (kecuali
# /api/health & webhook WhatsApp) wajib login dulu (username + password).
# Contoh password: python -c "import secrets;print(secrets.token_urlsafe(12))"
DASHBOARD_USERNAME=kozoadmin
DASHBOARD_PASSWORD=

# Rahasia bersama antara bridge Node.js dan server Python.
# Ganti dengan string acak! (contoh: python -c "import secrets;print(secrets.token_hex(16))")
BRIDGE_WEBHOOK_SECRET=ganti-ini-dengan-string-acak

# ============ OCR (Tesseract) ============
# Path binary tesseract (kosongkan jika sudah ada di PATH)
TESSERACT_CMD=tesseract
# TESSDATA_PREFIX=tesseract
# Bahasa OCR (ind = Indonesia, eng = Inggris)
OCR_LANG=ind+eng

# ============ DATA ============
DATA_DIR=data
DB_PATH=data/sales.db
