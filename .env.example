# ============ TELEGRAM ============
# Token dari @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# (Opsional) Batasi pengguna telegram yang boleh memakai bot.
# Isi dengan ID numerik dipisah koma, contoh: 123456789,987654321
# Kosongkan = semua orang boleh.
TELEGRAM_ALLOWED_IDS=

# ============ WHATSAPP BRIDGE (Node.js/Baileys) ============
# URL + port server bridge (whatsapp-bridge/index.js)
BRIDGE_URL=http://127.0.0.1:3100
BRIDGE_PORT=3100

# ============ API / DASHBOARD ============
API_HOST=0.0.0.0
API_PORT=8000

# (Opsional) Password untuk membuka dashboard web. Kosongkan = tanpa login.
# Jika diisi, semua halaman & API (kecuali /api/health & webhook WhatsApp)
# wajib login dulu. Contoh: python -c "import secrets;print(secrets.token_urlsafe(12))"
DASHBOARD_PASSWORD=

# Rahasia bersama antara bridge Node.js dan server Python.
# Ganti dengan string acak! (contoh: python -c "import secrets;print(secrets.token_hex(16))")
BRIDGE_WEBHOOK_SECRET=ganti-ini-dengan-string-acak

# ============ OCR (Tesseract) ============
# Path binary tesseract (kosongkan jika sudah ada di PATH)
TESSERACT_CMD=tesseract
# TESSDATA_PREFIX=tesseract
# Bahasa OCR (ind = Indonesia, eng = Inggris)
OCR_LANG=ind+eng

# ============ DATA ============
DATA_DIR=data
DB_PATH=data/sales.db
